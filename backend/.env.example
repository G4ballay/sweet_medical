# Server Config
PORT=#Puerto en el que se ejecutará el servidor.
HOST=#Dirección IP en la que se ejecutará el servidor. ej: localhost.

# Server Config
FRONTEND_URL=#URL del frontend que consumirá la API. ej: http://localhost:3000

# Repository Config 
DB_TYPE=#Puede ser "MONGO" o "MEMORY".

# Database Config
MONGODB_URI=#URI de conexión a MongoDB. Ej: mongodb+srv://user:password@cluster.mongodb.net/myDatabase?retryWrites=true&w=majority&appName=ClusterMyApp

# JWT Config
JWT_SECRET=#Secreto utilizado para firmar los tokens
JWT_EXPIRES_IN=#Tiempo de expiración de los tokens, ej: 24h, 7d, etc.